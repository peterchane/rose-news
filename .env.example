# Local secrets. Gitignored. Copy .env.example to start fresh.

# ---- Model ----
# Vercel AI Gateway: vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=
# Optional override. Defaults to anthropic/claude-sonnet-5 (free tier).
# Opus 5 needs paid credits on the Vercel account.
BRIEF_MODEL=

# ---- Email (Gmail SMTP) ----
# App Password, not your account password. Requires 2-Step Verification.
# Generate at https://myaccount.google.com/apppasswords
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=
FROM_NAME=Dad's Daily Brief

# ---- Recipients ----
ROSE_EMAIL=
# Blind copy, so you see exactly what Rose got.
COPY_EMAIL=you@example.com
# Where her replies land.
REPLY_TO_EMAIL=you@example.com
# Failures alert here, never to Rose.
ALERT_EMAIL=you@example.com

# ---- Sources ----
# Optional published Google Sheet CSV URL. Overrides feeds.txt and takes effect
# without a redeploy. File > Share > Publish to web > CSV.
FEEDS_SHEET_URL=

# ---- Deployment ----
# Must match the value set in Vercel. Generate: openssl rand -hex 32
CRON_SECRET=
# Auto-populated by `vercel env pull` once a Blob store is attached.
BLOB_READ_WRITE_TOKEN=
